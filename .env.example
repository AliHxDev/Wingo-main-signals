# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Application Port (defaults to 3000)
PORT=3000

# Environment Mode: 'development' | 'production' | 'test'
NODE_ENV=production

# PostgreSQL Database Connection String (Supabase / Render / Neon / Local)
# Supabase Pooler example (Port 6543 or 5432):
# DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
# When omitted, an in-memory PostgreSQL engine (pg-mem) is used automatically for preview.
DATABASE_URL=

# SSL Configuration for PostgreSQL connection ('true' or 'false').
# Note: SSL is enabled automatically for remote connections (Supabase, Neon, Render).
DATABASE_SSL=true

# Admin Credentials for Web Dashboard
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123456

# JWT Secret for Session Authentication
JWT_SECRET=wingo-1m-whatsapp-secret-key-prod-random-2026

# WhatsApp Newsletter Channel Identifier (e.g. 120363411395110604@newsletter)
DEFAULT_NEWSLETTER_JID=

# WinGo 1M Prediction Confidence Threshold (50-99%)
DEFAULT_CONFIDENCE_THRESHOLD=65

# WinGo 1M Bot Polling Interval in seconds (default 60s for 1M rounds)
DEFAULT_POLLING_INTERVAL=60
