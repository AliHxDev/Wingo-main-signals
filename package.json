    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "esbuild": "^0.25.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "luxon": "^3.7.2",
    "motion": "^12.23.24",
    "pg": "^8.23.0",
    "pg-mem": "^3.0.14",
    "pino": "^10.3.1",
